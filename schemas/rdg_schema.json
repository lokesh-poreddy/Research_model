{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research Development Graph (RDG) Schema",
  "type": "object",
  "properties": {
    "graph_id": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["Problem","Gap","Hypothesis","Experiment","Finding","Claim","ModelGenome","Strategy","MemoryRecord"]
          },
          "content": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "status": {
            "type": "string",
            "enum": ["pending","running","completed","failed","archived"]
          },
          "attributes": { "type": "object" },
          "links": { "type": "array", "items": { "type": "string" } },
          "times_tried": { "type": "integer", "minimum": 0 },
          "best_metric": { "type": ["number","null"] },
          "failure_count": { "type": "integer", "minimum": 0 }
        },
        "required": ["id", "type", "content"]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "relation": {
            "type": "string",
            "enum": ["identifies","motivates","tested-by","produces","supports","derives-from","saved-as","proposes","evaluated-as","informs","updates"]
          },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "properties": { "type": "object" }
        },
        "required": ["from", "to", "relation"]
      }
    }
  },
  "required": ["nodes", "edges"]
}
