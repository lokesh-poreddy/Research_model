{
  "$id": "genome.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GenomeDefinitions",
  "type": "object",
  "definitions": {
    "TargetModelGenome": {
      "type": "object",
      "required": ["id", "schema_version", "representation"],
      "properties": {
        "id": { "type": "string" },
        "schema_version": { "type": "string" },
        "representation": { "type": "object" },
        "generation": { "type": ["integer", "null"] },
        "parent_ids": { "type": ["array", "null"], "items": { "type": "string" } },
        "operator": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ResearchSystemGenome": {
      "type": "object",
      "required": ["id", "schema_version", "config"],
      "properties": {
        "id": { "type": "string" },
        "schema_version": { "type": "string" },
        "config": { "type": "object" },
        "version": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
