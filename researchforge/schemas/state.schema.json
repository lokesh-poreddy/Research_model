{
  "$id": "state.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchState",
  "type": "object",
  "required": ["id", "schema_version"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "problem_id": { "type": ["string", "null"] },
    "active_question_id": { "type": ["string", "null"] },
    "hypotheses": { "type": ["array", "null"], "items": { "type": "string" } },
    "current_decision_id": { "type": ["string", "null"] },
    "selected_tmg_id": { "type": ["string", "null"] },
    "selected_rsg_id": { "type": ["string", "null"] },
    "recent_experiment_refs": { "type": ["array", "null"], "items": { "type": "string" } },
    "recent_evidence_refs": { "type": ["array", "null"], "items": { "type": "string" } },
    "recent_failures": { "type": ["array", "null"], "items": { "type": "string" } },
    "memory_context": { "type": ["object", "null"] },
    "best_known_result": { "type": ["object", "null"] },
    "budget_consumed": { "type": ["number", "null"] },
    "budget_remaining": { "type": ["number", "null"] },
    "research_phase": { "type": ["string", "null"] },
    "unresolved_contradictions": { "type": ["array", "null"], "items": { "type": "string" } },
    "policy_state": { "type": ["object", "null"] },
    "provenance_id": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
