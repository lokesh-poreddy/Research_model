{
  "$id": "experiment.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExperimentDefinitions",
  "type": "object",
  "definitions": {
    "ExperimentSpec": {
      "type": "object",
      "required": ["id", "schema_version"],
      "properties": {
        "id": { "type": "string" },
        "schema_version": { "type": "string" },
        "rsg_id": { "type": ["string", "null"] },
        "rsg_fingerprint": { "type": ["string", "null"] },
        "research_problem_id": { "type": ["string", "null"] },
        "research_question_id": { "type": ["string", "null"] },
        "hypothesis_id": { "type": ["string", "null"] },
        "decision_id": { "type": ["string", "null"] },
        "target_model_genome_id": { "type": ["string", "null"] },
        "research_system_genome_id": { "type": ["string", "null"] },
        "dataset_ref": { "type": ["string", "null"] },
        "preprocessing": { "type": ["object", "null"] },
        "intervention_description": { "type": ["string", "null"] },
        "baseline_config": { "type": ["object", "null"] },
        "metrics": { "type": ["array", "null"], "items": { "type": "string" } },
        "seeds": { "type": ["array", "null"], "items": { "type": "integer" } },
        "resource_requirements": { "type": ["object", "null"] },
        "expected_outputs": { "type": ["array", "null"], "items": { "type": "string" } },
        "validity_requirements": { "type": ["object", "null"] },
        "provenance": { "type": ["object", "null"] },
        "tmg_id": { "type": ["string", "null"] },
        "tmg_fingerprint": { "type": ["string", "null"] },
        "dataset_id": { "type": ["string", "null"] },
        "dataset_fingerprint": { "type": ["string", "null"] },
        "evaluator": { "type": ["string", "null"] },
        "metric": { "type": ["string", "null"] },
        "split": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] },
        "researchforge_version": { "type": ["string", "null"] },
        "code_revision": { "type": ["string", "null"] },
        "dependency_fingerprint": { "type": ["string", "null"] },
        "environment_fingerprint": { "type": ["string", "null"] },
        "adapter_id": { "type": ["string", "null"] },
        "execution_mode": { "type": ["string", "null"] },
        "resource_requirements": { "type": ["object", "null"] },
        "expected_cost": { "type": ["number", "null"] },
        "validity_config_fingerprint": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ExperimentRun": {
      "type": "object",
      "required": ["id", "schema_version", "spec_id"],
      "properties": {
        "id": { "type": "string" },
        "schema_version": { "type": "string" },
        "spec_id": { "type": "string" },
        "start_time": { "type": ["string", "null"], "format": "date-time" },
        "end_time": { "type": ["string", "null"], "format": "date-time" },
        "runner_version": { "type": ["string", "null"] },
        "execution_mode": { "type": ["string", "null"] },
        "adapter": { "type": ["string", "null"] },
        "exit_status": { "type": ["string", "null"] },
        "resource_usage": { "type": ["object", "null"] },
        "safety_result": { "type": ["object", "null"] },
        "validity_result": { "type": ["object", "null"] },
        "artifact_refs": { "type": ["array", "null"], "items": { "type": "string" } },
        "outcome_ref": { "type": ["string", "null"] }
        ,
        "experiment_spec_id": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "environment_fingerprint": { "type": ["string", "null"] },
        "code_revision": { "type": ["string", "null"] },
        "dataset_fingerprint": { "type": ["string", "null"] },
        "model_fingerprint": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] },
        "produced_artifacts": { "type": ["array", "null"], "items": { "type": "string" } },
        "failure_info": { "type": ["object", "null"] },
        "provenance": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    }
  }
}
