{
  "$id": "diagnosis.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Diagnosis",
  "type": "object",
  "required": ["id", "schema_version", "outcome_id"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "outcome_id": { "type": "string" },
    "interpretation": { "type": ["string", "null"] },
    "probable_causes": { "type": ["array", "null"], "items": { "type": "string" } },
    "confidence": { "type": ["number", "null"] },
    "recovery_attempts": { "type": ["array", "null"], "items": { "type": "object" } },
    "recovery_results": { "type": ["array", "null"], "items": { "type": "object" } }
  },
  "additionalProperties": false
}
