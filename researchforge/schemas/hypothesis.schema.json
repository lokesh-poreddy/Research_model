{
  "$id": "hypothesis.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hypothesis",
  "type": "object",
  "required": ["id", "schema_version", "research_question_id", "statement"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "research_question_id": { "type": "string" },
    "statement": { "type": "string" },
    "prediction": { "type": ["string", "null"] },
    "assumptions": { "type": ["array", "null"], "items": { "type": "string" } },
    "provenance_id": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
