# ResearchForge-ECRM Environment Configuration
# Copy to .env and fill in your API keys

# ── LLM Providers ────────────────────────────────────────────────────────────
LLM_PROVIDER=mock           # "openai" | "anthropic" | "mock"
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./researchforge.db
# DATABASE_URL=postgresql://user:password@localhost:5432/researchforge

# ── Neo4j (optional) ─────────────────────────────────────────────────────────
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Vector Store ─────────────────────────────────────────────────────────────
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db

# ── External APIs ─────────────────────────────────────────────────────────────
OPENALEX_EMAIL=your@email.com
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=

# ── Policy ───────────────────────────────────────────────────────────────────
POLICY_TYPE=ucb
UCB_C=1.41
FAILURE_PENALTY_FACTOR=0.5

# ── Memory ───────────────────────────────────────────────────────────────────
MEMORY_RETAIN_LAMBDA=0.01
MEMORY_RETAIN_THRESHOLD=0.1
MEMORY_MAX_RECORDS=10000
NTR_THRESHOLD=0.3

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
